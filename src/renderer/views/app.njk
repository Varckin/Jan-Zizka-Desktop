<link rel="stylesheet" href="/static/css/chat/modals.css">
<link rel="stylesheet" href="/static/css/chat/admin-modals.css">
<link rel="stylesheet" href="/static/css/chat/invite-links.css">
<link rel="stylesheet" href="/static/css/chat/search-modal.css">
<link rel="stylesheet" href="/static/css/chat/discover.css">
<link rel="stylesheet" href="/static/css/chat/messages.css">
<link rel="stylesheet" href="/static/css/chat/attachments.css">
<link rel="stylesheet" href="/static/css/chat/contacts.css">
<link rel="stylesheet" href="/static/css/chat/mentions.css">
<link rel="stylesheet" href="/static/css/chat/voice-call.css">
<link rel="stylesheet" href="/static/css/chat/group-voice.css">
<link rel="stylesheet" href="/static/css/chat/folders.css">
<link rel="stylesheet" href="/static/css/chat/responsive.css">

<link rel="stylesheet" href="/static/css/e2e/layout.css">
<link rel="stylesheet" href="/static/css/e2e/messages.css">
<link rel="stylesheet" href="/static/css/e2e/modals.css">
<link rel="stylesheet" href="/static/css/e2e/search.css">
<link rel="stylesheet" href="/static/css/e2e/profile.css">
<link rel="stylesheet" href="/static/css/e2e/vault.css">

<link rel="stylesheet" href="/static/css/profile/animations.css">
<link rel="stylesheet" href="/static/css/profile/card.css">
<link rel="stylesheet" href="/static/css/profile/avatar.css">
<link rel="stylesheet" href="/static/css/profile/info.css">
<link rel="stylesheet" href="/static/css/profile/buttons.css">
<link rel="stylesheet" href="/static/css/profile/sessions.css">
<link rel="stylesheet" href="/static/css/profile/settings.css">
<link rel="stylesheet" href="/static/css/profile/toast.css">
<link rel="stylesheet" href="/static/css/profile/modals.css">
