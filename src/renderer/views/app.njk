<link rel="stylesheet" href="/static/css/core_chat/input.css">
<link rel="stylesheet" href="/static/css/core_chat/dragdrop.css">
<link rel="stylesheet" href="/static/css/core_chat/buttons.css">
<link rel="stylesheet" href="/static/css/core_chat/modals.css">
<link rel="stylesheet" href="/static/css/core_chat/emoji.css">
<link rel="stylesheet" href="/static/css/core_chat/context-menu.css">
<link rel="stylesheet" href="/static/css/core_chat/toast.css">
<link rel="stylesheet" href="/static/css/core_chat/responsive.css">

<link rel="stylesheet" href="/static/css/chat/dropdowns.css">
