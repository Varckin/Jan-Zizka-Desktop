<div class="e2e-main" id="e2e-main">
  <div class="e2e-header">
    <div class="e2e-info">
      <button id="e2e-toggle-sidebar" class="e2e-btn-icon e2e-toggle-sidebar" type="button" aria-label="{{ t('e2e_toggle_sidebar') }}">
        <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="e2e-name" id="e2e-chat-name" role="button" tabindex="0">{{ t('select_chat') }}</span>
      <span id="e2e-online-status" class="e2e-online is-hidden"></span>
      <span class="e2e-typing is-hidden" id="e2e-typing" aria-live="polite"></span>
    </div>
    <div class="e2e-actions">
      <button id="e2e-search-msg-btn" class="e2e-btn-icon is-hidden" type="button" title="{{ t('e2e_search_messages') }}" aria-label="{{ t('e2e_search_messages') }}">
        <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
      <button id="e2e-delete-chat-btn" class="e2e-btn-icon is-hidden" type="button" title="{{ t('e2e_delete_chat') }}" aria-label="{{ t('e2e_delete_chat') }}">
        <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
          <line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
        </svg>
      </button>
      <span class="e2e-lock" title="{{ t('e2e_locked_tooltip') }}">
        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </span>
    </div>
  </div>

  <div id="e2e-identity-warning" class="e2e-identity-warning is-hidden" role="alert">
    <span class="e2e-identity-warning-icon" aria-hidden="true">⚠️</span>
    <span id="e2e-identity-warning-text"></span>
    <button id="e2e-identity-accept" class="e2e-btn-secondary" type="button">{{ t('e2e_accept_new_key') }}</button>
    <button id="e2e-identity-dismiss" class="e2e-btn-icon" type="button" aria-label="{{ t('close') }}">✕</button>
  </div>

  <div class="e2e-messages" id="e2e-messages">
    <div class="e2e-empty">{{ t('select_chat_prompt') }}</div>
  </div>

  <div class="e2e-input-area is-hidden" id="e2e-input-area">
    <div id="e2e-reply-indicator" class="e2e-reply-indicator is-hidden">
      <span class="e2e-reply-label">{{ t('replying_to') }} <span id="e2e-reply-sender"></span></span>
      <span class="e2e-reply-preview" id="e2e-reply-preview"></span>
      <button id="e2e-cancel-reply" class="e2e-btn-icon" type="button">
        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div id="e2e-file-preview" class="e2e-file-preview is-hidden"></div>
    <div class="input-stack">
      <textarea id="e2e-message-input" rows="1" placeholder="{{ t('type_message') }}"></textarea>
      <div class="input-toolbar input-toolbar-bottom">
        <div class="toolbar-group">
          <button id="e2e-attach-btn" class="e2e-btn-icon" type="button" title="{{ t('attach_file') }}" aria-label="{{ t('attach_file') }}">
            <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
            </svg>
          </button>
          <input type="file" id="e2e-file-input" multiple hidden>
          <button id="e2e-emoji-btn" class="e2e-btn-icon" type="button" title="Emoji" aria-label="Emoji">
            <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9.5"/>
              <path d="M8.5 14.5s1.3 1.8 3.5 1.8 3.5-1.8 3.5-1.8"/>
              <line x1="9" y1="9.5" x2="9.01" y2="9.5"/>
              <line x1="15" y1="9.5" x2="15.01" y2="9.5"/>
            </svg>
          </button>
        </div>
        <button id="e2e-send-btn" class="e2e-btn-primary" type="button">
          <svg class="icon icon-sm send-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
          <span>{{ t('send') }}</span>
        </button>
      </div>
    </div>
  </div>
</div>
