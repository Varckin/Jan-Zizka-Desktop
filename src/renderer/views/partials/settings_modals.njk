<div id="avatar-crop-modal" class="modal">
    <div class="modal-content avatar-crop-content">
        <h2>{{ t('crop_avatar') }}</h2>
        <div class="avatar-crop-container">
            <img id="avatar-crop-image" src="data:," alt="Crop">
        </div>
        <div class="avatar-crop-actions">
            <button id="avatar-crop-cancel" class="btn-secondary" type="button">{{ t('cancel') }}</button>
            <button id="avatar-crop-confirm" class="btn-primary" type="button">{{ t('save') }}</button>
        </div>
    </div>
</div>

<div id="change-password-modal" class="modal">
    <div class="modal-content">
        <button class="close" id="change-password-close" type="button" title="{{ t('close') }}">✕</button>
        <h2>{{ t('change_password') }}</h2>
        <form id="change-password-form">
            <div class="form-group">
                <label for="old-password">{{ t('old_password') }}</label>
                <input type="password" id="old-password" name="old_password" required>
                <div class="error-msg"></div>
            </div>
            <div class="form-group">
                <label for="new-password-profile">{{ t('new_password') }}</label>
                <input type="password" id="new-password-profile" name="new_password" required minlength="8" data-password-strength>
                <div class="error-msg"></div>
            </div>
            <div class="form-group">
                <label for="confirm-password-profile">{{ t('confirm_password') }}</label>
                <input type="password" id="confirm-password-profile" name="confirm_password" required>
                <div class="error-msg"></div>
            </div>
            <div class="form-error"></div>
            <button type="submit" class="btn-primary">{{ t('save') }}</button>
        </form>
    </div>
</div>

<div id="email-change-modal" class="modal">
    <div class="modal-content email-change-content">
        <button class="close" id="email-change-close" type="button" title="{{ t('close') }}">✕</button>

        <div class="email-change-step" id="email-change-step-identity">
            <div class="email-change-icon email-change-icon-shield">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9.5 12.3l1.9 1.9 3.4-3.7"/></svg>
            </div>
            <h2>{{ t('confirm_identity') }}</h2>
            <p class="email-change-subtitle">{{ t('identity_hint') }}</p>
            <form id="email-change-identity-form">
                <div class="form-group">
                    <label for="email-change-password">{{ t('current_password') }}</label>
                    <input type="password" id="email-change-password" autocomplete="current-password" spellcheck="false" required>
                </div>
                <div class="email-change-error" id="email-change-identity-error"></div>
                <div class="email-change-actions">
                    <button type="button" class="btn-secondary" id="email-change-identity-cancel">{{ t('cancel') }}</button>
                    <button type="submit" class="btn-primary" id="email-change-identity-continue">{{ t('continue') }}</button>
                </div>
            </form>
        </div>

        <div class="email-change-step is-hidden" id="email-change-step-request">
            <button type="button" class="email-change-back" id="email-change-back-btn" aria-label="{{ t('back') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                <span>{{ t('back') }}</span>
            </button>
            <div class="email-change-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </div>
            <h2>{{ t('change_email') }}</h2>
            <p class="email-change-subtitle">{{ t('email_change_hint') }}</p>
            <form id="email-change-request-form">
                <div class="form-group">
                    <label for="email-change-new-email">{{ t('new_email') }}</label>
                    <input type="email" id="email-change-new-email" autocomplete="email" spellcheck="false" required>
                </div>
                <div class="email-change-error" id="email-change-request-error"></div>
                <div class="email-change-actions">
                    <button type="button" class="btn-secondary" id="email-change-request-cancel">{{ t('cancel') }}</button>
                    <button type="submit" class="btn-primary" id="email-change-send-btn">{{ t('send_code') }}</button>
                </div>
            </form>
        </div>

        <div class="email-change-step is-hidden" id="email-change-step-code">
            <div class="email-change-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.4"/></svg>
            </div>
            <h2>{{ t('enter_code') }}</h2>
            <p class="email-change-subtitle">{{ t('code_sent_to') }} <span class="email-change-target" id="email-change-target-email"></span></p>
            <div class="otp-inputs" id="email-change-otp" role="group" aria-label="{{ t('enter_code') }}">
                <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="1">
                <input type="text" inputmode="numeric" maxlength="1">
                <input type="text" inputmode="numeric" maxlength="1">
                <input type="text" inputmode="numeric" maxlength="1">
                <input type="text" inputmode="numeric" maxlength="1">
                <input type="text" inputmode="numeric" maxlength="1">
            </div>
            <div class="email-change-error" id="email-change-code-error"></div>
            <div class="email-change-actions">
                <button type="button" class="btn-secondary" id="email-change-cancel-btn">{{ t('cancel_change') }}</button>
                <button type="button" class="btn-resend" id="email-change-resend-btn">{{ t('resend_code') }}</button>
            </div>
        </div>

        <div class="email-change-step is-hidden" id="email-change-step-success">
            <svg class="email-change-check" viewBox="0 0 52 52" aria-hidden="true">
                <circle class="email-change-check-circle" cx="26" cy="26" r="24" fill="none"/>
                <path class="email-change-check-path" fill="none" d="M14.5 26.5l7.5 7.5 15.5-15.5"/>
            </svg>
            <h2>{{ t('email_change_success') }}</h2>
            <p class="email-change-subtitle">{{ t('email_change_notice_sent') }}</p>
            <p class="email-change-sessions-note">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/></svg>
                <span>{{ t('email_change_sessions_note') }}</span>
            </p>
        </div>
    </div>
</div>
