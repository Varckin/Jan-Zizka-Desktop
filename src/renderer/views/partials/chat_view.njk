<div class="chat-app">
  <div class="folder-rail is-hidden" id="folder-rail"></div>
  <div class="chat-sidebar" id="chat-sidebar">
    <div class="sidebar-header">
      <div class="sidebar-title">
        <button id="contacts-btn" class="btn-icon contacts-btn" type="button" title="{{ t('contacts') }}" aria-haspopup="dialog" aria-expanded="false">
          <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </button>
        <h2>{{ t('chats_title') }}</h2>
      </div>
      <div class="sidebar-actions">
        <button id="blocked-users-btn" class="btn-icon is-hidden" type="button" title="{{ t('blocked_users') }}">
          <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </button>
        <div class="dropdown">
          <button id="create-chat-btn" class="btn-icon" type="button" title="{{ t('create_chat') }}">
            <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>
          <div class="dropdown-menu" id="create-chat-menu">
            <a href="#" data-action="discover">
              <span class="menu-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
              </span>
              <span class="menu-label">{{ t('discover_title') }}</span>
            </a>
            <a href="#" data-action="group">
              <span class="menu-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </span>
              <span class="menu-label">{{ t('new_group') }}</span>
            </a>
            <a href="#" data-action="channel">
              <span class="menu-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
              </span>
              <span class="menu-label">{{ t('new_channel') }}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="search-box">
      <input type="text" id="chat-search" placeholder="{{ t('search_chats') }}" />
    </div>
    <div class="chat-list" id="chat-list">
      <div class="loading">{{ t('loading') }}</div>
    </div>
  </div>

  <div class="chat-main">
    <div class="chat-header" id="chat-header">
      <div class="chat-info" id="chat-info">
        <button id="toggle-sidebar" class="btn-icon btn-icon-hidden" type="button">
          <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <span class="chat-name" id="chat-name-span">{{ t('select_chat') }}</span>
        <span id="chat-members-count" class="members-count is-hidden"></span>
        <span id="chat-online-status" class="online-status is-hidden"></span>
        <span class="chat-typing is-hidden" id="chat-typing"></span>
      </div>
      <div class="chat-actions">
        <button id="search-msg-btn" class="btn-icon is-hidden" type="button" title="{{ t('search_messages') }}">
          <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </button>
        <button id="group-voice-btn" class="btn-icon is-hidden" type="button" title="{{ t('gv_open_room') }}">
          <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </button>
        <button id="voice-call-btn" class="btn-icon is-hidden" type="button" title="{{ t('call_button') }}">
          <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </button>
        <button id="chat-settings-btn" class="btn-icon is-hidden" type="button" title="{{ t('settings') }}">
          <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/><path d="M12 1v3m0 18v3M4.22 4.22l2.12 2.12m11.32 11.32l2.12 2.12M1 12h3m18 0h3M4.22 19.78l2.12-2.12m11.32-11.32l2.12-2.12"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="pinned-bar" class="pinned-bar is-hidden">
      <span class="pinned-bar-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/></svg>
      </span>
      <div class="pinned-bar-body">
        <div class="pinned-bar-label">{{ t('pinned_message') }}</div>
        <div class="pinned-bar-text"><span id="pinned-bar-sender"></span> <span id="pinned-bar-preview"></span></div>
      </div>
      <span id="pinned-bar-counter" class="pinned-bar-counter is-hidden"></span>
      <button id="pinned-bar-prev" class="btn-icon is-hidden" type="button" title="{{ t('pinned_prev') }}" aria-label="{{ t('pinned_prev') }}">
        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button id="pinned-bar-next" class="btn-icon is-hidden" type="button" title="{{ t('pinned_next') }}" aria-label="{{ t('pinned_next') }}">
        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <button id="pinned-bar-close" class="btn-icon is-hidden" type="button" title="{{ t('unpin_message') }}" aria-label="{{ t('unpin_message') }}">
        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="chat-messages" id="chat-messages">
      <div class="empty-state">{{ t('select_chat_prompt') }}</div>
    </div>

    <div id="group-voice-bar" class="gv-bar is-hidden"></div>

    <div class="chat-input-area is-hidden" id="chat-input-area">
      <div id="voice-recording-indicator" class="voice-indicator is-hidden">
        <span class="voice-dot" aria-hidden="true"></span>
        <span id="voice-timer" class="voice-timer">0:00</span>
        <button id="voice-stop-btn" class="btn-icon voice-stop" type="button">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
        </button>
        <span class="voice-hint">{{ t('recording') }}</span>
      </div>

      <div id="reply-indicator" class="reply-indicator is-hidden">
        <span>{{ t('replying_to') }} <span id="reply-sender"></span>: <span id="reply-preview"></span></span>
        <button id="cancel-reply" class="btn-icon" type="button">
          <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div id="file-preview-container" class="file-preview-container is-hidden"></div>
      <div class="input-stack">
        <textarea id="message-input" rows="1" placeholder="{{ t('type_message') }}"></textarea>
        <div class="input-toolbar input-toolbar-bottom">
          <div class="toolbar-group">
            <button id="gif-btn" class="btn-icon" type="button" title="{{ t('search_gifs') }}">
              <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="5" width="19" height="14" rx="3"/>
                <text x="12" y="15.4" text-anchor="middle" font-size="8" font-weight="700" letter-spacing="0.5" fill="currentColor" stroke="none" font-family="inherit">GIF</text>
              </svg>
            </button>
            <button id="voice-btn" class="btn-icon" type="button" title="{{ t('voice_message') }}">
              <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                <line x1="12" y1="19" x2="12" y2="23"/>
                <line x1="8" y1="23" x2="16" y2="23"/>
              </svg>
            </button>
            <label for="file-input" class="btn-icon attach-btn" title="{{ t('attach_file') }}">
              <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
              </svg>
            </label>
            <input type="file" id="file-input" multiple hidden>
            <button id="emoji-btn" class="btn-icon" type="button" title="Emoji">
              <svg class="icon icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9.5"/>
                <path d="M8.5 14.5s1.3 1.8 3.5 1.8 3.5-1.8 3.5-1.8"/>
                <line x1="9" y1="9.5" x2="9.01" y2="9.5"/>
                <line x1="15" y1="9.5" x2="15.01" y2="9.5"/>
              </svg>
            </button>
          </div>
          <button id="send-btn" class="btn-primary" type="button">
            <svg class="icon icon-sm send-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            <span>{{ t('send') }}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
