        <label for="desktop-close-to-tray">{{ t('desktop_close_to_tray') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-close-to-tray" checked>
            <label for="desktop-close-to-tray" class="toggle-label"></label>
        </div>
        <small class="hint">{{ t('desktop_close_to_tray_hint') }}</small>
    </div>
    <div class="settings-item">
        <label for="desktop-tray-enabled">{{ t('desktop_tray_icon') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-tray-enabled" checked>
            <label for="desktop-tray-enabled" class="toggle-label"></label>
        </div>
        <small class="hint">{{ t('desktop_tray_icon_hint') }}</small>
    </div>
    <div class="settings-item">
        <label for="desktop-auto-start">{{ t('desktop_auto_start') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-auto-start">
            <label for="desktop-auto-start" class="toggle-label"></label>
        </div>
        <small class="hint">{{ t('desktop_auto_start_hint') }}</small>
    </div>
    <div class="settings-item">
        <label for="desktop-auto-update">{{ t('desktop_auto_update') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-auto-update" checked>
            <label for="desktop-auto-update" class="toggle-label"></label>
        </div>
        <small class="hint">{{ t('desktop_auto_update_hint') }}</small>
    </div>
    <div class="settings-item">
        <label for="desktop-clear-cache">{{ t('desktop_clear_cache') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-clear-cache" checked>
