    </div>
    <div class="settings-item">
        <label for="lang-switcher">{{ t('desktop_interface_language') }}</label>
        {% include "partials/lang_switcher.njk" %}
        <small class="hint">{{ t('desktop_interface_language_hint') }}</small>
    </div>
</div>
