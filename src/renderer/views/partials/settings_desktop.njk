<div class="settings-block">
    <h3>{{ t('desktop_notifications_title') }}</h3>
    <div class="settings-item">
        <label for="desktop-notif-enabled">{{ t('desktop_notifications_enable') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-notif-enabled" checked>
            <label for="desktop-notif-enabled" class="toggle-label"></label>
        </div>
        <small class="hint">{{ t('desktop_notifications_enable_hint') }}</small>
    </div>
    <div class="settings-item">
        <label for="desktop-notif-sound">{{ t('desktop_notifications_sound') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-notif-sound" checked>
            <label for="desktop-notif-sound" class="toggle-label"></label>
        </div>
        <small class="hint">{{ t('desktop_notifications_sound_hint') }}</small>
    </div>
    <div class="settings-item">
        <label for="desktop-notif-preview">{{ t('desktop_notifications_preview') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-notif-preview" checked>
            <label for="desktop-notif-preview" class="toggle-label"></label>
        </div>
        <small class="hint">{{ t('desktop_notifications_preview_hint') }}</small>
    </div>
    <div class="settings-item">
        <label for="desktop-notif-hidden">{{ t('desktop_notifications_hidden') }}</label>
        <div class="toggle-wrapper">
            <input type="checkbox" id="desktop-notif-hidden" checked>
            <label for="desktop-notif-hidden" class="toggle-label"></label>
        </div>
        <small class="hint">{{ t('desktop_notifications_hidden_hint') }}</small>
    </div>
</div>
<div class="settings-block">
    <h3>{{ t('desktop_app_title') }}</h3>
